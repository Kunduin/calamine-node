{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "unicorn", "node"],
  "ignorePatterns": ["native/", "dist/", "build-test/", "target/"],
  "rules": {
    "typescript/no-explicit-any": "error"
  }
}
